<?xml version="1.0" encoding="utf-8"?>
<!-- res/layout/activity_main.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F4F8"
    tools:context=".MainActivity">

    <!-- ══ Header Banner ══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#1A237E"
        android:paddingTop="24dp"
        android:paddingBottom="20dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌏 Tamil Nadu"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tour Guide"
            android:textSize="16sp"
            android:textColor="#90CAF9"
            android:layout_marginBottom="14dp" />

        <!-- Search Bar -->
        <EditText
            android:id="@+id/etSearch"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:hint="Search destinations..."
            android:textColorHint="#90A4AE"
            android:textColor="#212121"
            android:textSize="14sp"
            android:background="#FFFFFF"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:singleLine="true" />

    </LinearLayout>

    <!-- ══ Category Filter Tabs ══ -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#283593"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/layoutCategories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <Button
                android:id="@+id/btnAll"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="All"
                android:textSize="12sp"
                android:backgroundTint="#FFFFFF"
                android:textColor="#1A237E"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnTemple"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="🛕 Temples"
                android:textSize="12sp"
                android:backgroundTint="#3949AB"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnBeach"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="🏖 Beaches"
                android:textSize="12sp"
                android:backgroundTint="#3949AB"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnHill"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="⛰ Hills"
                android:textSize="12sp"
                android:backgroundTint="#3949AB"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnHeritage"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="🏛 Heritage"
                android:textSize="12sp"
                android:backgroundTint="#3949AB"
                android:textColor="#FFFFFF" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- ══ Result Count Label ══ -->
    <TextView
        android:id="@+id/tvCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Showing all destinations"
        android:textSize="12sp"
        android:textColor="#607D8B"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="6dp" />

    <!-- ══ Place List ══ -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp"
        android:clipToPadding="false" />

</LinearLayout>
